{
  "name": "shadow-legion",
  "version": "1.1.0",
  "description": "暗影军团 - 俯视角动作生存游戏",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare:electron": "node node_modules/electron/install.js",
    "desktop": "npm run build && npm run prepare:electron && electron .",
    "package:win": "npm run build && npm run prepare:electron && electron-builder --win portable --x64"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.shadowlegion.game",
    "productName": "Shadow Legion",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shadow-Legion-${version}-Portable.${ext}"
    }
  }
}
