{
  "name": "shadow-legion",
  "version": "1.3.0-rc.1",
  "description": "五章五十段暖色旅途、角色专精与影子搭档的 PC 浏览器动作守护游戏",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import ./scripts/test-loader.mjs --test src/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "analyze:pacing": "node --import ./scripts/test-loader.mjs scripts/analyze-pacing.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run test && npm run build && npm run check:dist",
    "check:security": "npm audit --audit-level=moderate",
    "release:web": "npm run check && npm run check:security && node scripts/prepare-web-release.mjs",
    "prepare:electron": "node node_modules/electron/install.js",
    "desktop": "npm run build && npm run prepare:electron && electron .",
    "package:win": "npm run build && npm run prepare:electron && electron-builder --win portable --x64"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.shadowlegion.game",
    "productName": "Shadow Legion",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shadow-Legion-${version}-Portable.${ext}"
    }
  }
}
